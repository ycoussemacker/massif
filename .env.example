# Massif — environment variables. Copy to .env.local (web) / .env (ingest) and fill in.
# NEVER commit the filled files.

# ── Supabase ──────────────────────────────────────────────
# From your personal Supabase project (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Strava (OAuth, read-only) ─────────────────────────────
# Create an API app at https://www.strava.com/settings/api (Authorization Callback Domain = localhost).
# CLIENT_ID/SECRET are needed by BOTH ingest/.env AND web/.env.local — the web app now runs the OAuth
# "Connecter Strava" flow from the Profil page and writes the token to the integration_tokens table.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Legacy: obtained once via scripts/strava_oauth.py (scope activity:read_all). Still read as a fallback
# when integration_tokens has no strava row (the UI OAuth flow is now the preferred path).
STRAVA_REFRESH_TOKEN=

# ── Garmin Connect (python-garminconnect) ─────────────────
# Used once to log in; OAuth tokens are then cached in GARMIN_TOKEN_DIR.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=~/.garminconnect

# ── Coach (Anthropic) ─────────────────────────────────────
ANTHROPIC_API_KEY=
# Daily coach run. Bump to claude-opus-4-8 for heavier analyses.
COACH_MODEL=claude-sonnet-4-6

# ── Athlete ───────────────────────────────────────────────
ATHLETE_TZ=Europe/Paris

# ── Phone access / production (see ops/PHONE_ACCESS.md) ────
# Login gate (web): a single shared password + an HMAC secret for the signed session cookie.
# When BOTH are unset the gate is OFF (local dev). Set them in Vercel (server-only, NO NEXT_PUBLIC_).
APP_PASSWORD=
AUTH_SECRET=
# Web Push (VAPID). Generate once: `npx web-push generate-vapid-keys`.
# The PUBLIC key is needed by the browser → expose it as NEXT_PUBLIC_VAPID_PUBLIC_KEY (web).
# The sender (coach) needs all three: VAPID_PUBLIC_KEY (same value), VAPID_PRIVATE_KEY, VAPID_SUBJECT.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Set in the GitHub Actions cron only: makes the coach idempotent per day (no duplicate push).
# COACH_SKIP_IF_DONE=1
